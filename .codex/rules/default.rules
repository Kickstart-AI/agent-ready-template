# Rules match command prefixes; see README.md for their limits.
# Keep in sync with .claude/settings.json. Claude deny and ask rules are both forbidden here.

# Claude deny
prefix_rule(pattern = ["sudo"], decision = "forbidden")
prefix_rule(pattern = ["git", "push"], decision = "forbidden")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden")
prefix_rule(pattern = ["git", "clean"], decision = "forbidden")
prefix_rule(pattern = ["git", "filter-branch"], decision = "forbidden")
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "forbidden")
prefix_rule(pattern = ["gh", "repo", "delete"], decision = "forbidden")
prefix_rule(pattern = ["gh", "secret"], decision = "forbidden")
prefix_rule(pattern = ["tofu", ["apply", "destroy"]], decision = "forbidden")
prefix_rule(pattern = ["kubectl", ["delete", "apply"]], decision = "forbidden")
prefix_rule(pattern = ["helm", ["install", "upgrade", "uninstall"]], decision = "forbidden")
prefix_rule(pattern = [["aws", "gcloud", "az", "gsutil", "bq", "vercel"]], decision = "forbidden")
prefix_rule(pattern = [["npm", "pnpm", "uv"], "publish"], decision = "forbidden")
prefix_rule(pattern = ["twine", "upload"], decision = "forbidden")
prefix_rule(pattern = [["curl", "wget", "ssh", "scp", "nc", "printenv", "env"]], decision = "forbidden")

# Claude ask. The rm and terraform rules also cover the Claude deny rules for rm -rf and terraform apply.
prefix_rule(pattern = ["npm", ["install", "i", "ci", "add", "update"]], decision = "forbidden")
prefix_rule(pattern = ["npx"], decision = "forbidden")
prefix_rule(pattern = ["pnpm", ["install", "i", "add", "update", "dlx"]], decision = "forbidden")
prefix_rule(pattern = ["uv", ["add", "sync", "lock", "pip"]], decision = "forbidden")
prefix_rule(pattern = ["uvx"], decision = "forbidden")
prefix_rule(pattern = [["pip", "pip3"], "install"], decision = "forbidden")
prefix_rule(pattern = [["python", "python3"], "-m", "pip"], decision = "forbidden")
prefix_rule(pattern = ["yarn"], decision = "forbidden")
prefix_rule(pattern = ["bun", ["add", "install", "i"]], decision = "forbidden")
prefix_rule(pattern = ["git", ["commit", "rebase", "restore"]], decision = "forbidden")
prefix_rule(pattern = ["git", "checkout", ["--", "."]], decision = "forbidden")
prefix_rule(pattern = ["git", "branch", "-D"], decision = "forbidden")
prefix_rule(pattern = ["git", "stash", "drop"], decision = "forbidden")
prefix_rule(pattern = [["rm", "docker", "terraform"]], decision = "forbidden")
