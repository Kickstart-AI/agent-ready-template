{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "agent-ready-template",
  "version": "0.2.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "dead-code": "knip",
    "duplicate-code": "jscpd --min-lines 8 --min-tokens 50 src",
    "secret-scan": "secretlint \"**/*\" --maskSecrets --format stylish",
    "validate": "pnpm lint && pnpm typecheck && pnpm dead-code && pnpm duplicate-code && pnpm secret-scan"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "jscpd": "5.3.1",
    "knip": "6.37.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "secretlint": "13.0.5",
    "typescript-eslint": "8.70.1",
    "typescript": "6.0.3"
  },
  "knip": {
    "ignoreDependencies": [
      "@secretlint/secretlint-rule-preset-recommend"
    ]
  }
}
