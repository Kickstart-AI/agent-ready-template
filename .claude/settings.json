{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform state *)",
      "Bash(tofu apply *)",
      "Bash(tofu destroy *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl apply *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(az *)",
      "Bash(gsutil *)",
      "Bash(bq *)",
      "Bash(vercel *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(uv publish *)",
      "Bash(twine upload *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(printenv *)",
      "Bash(env)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm update *)",
      "Bash(npx *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm update *)",
      "Bash(pnpm dlx *)",
      "Bash(uv add *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uvx *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip *)",
      "Bash(python3 -m pip *)",
      "Bash(uv pip *)",
      "Bash(pnpm i *)",
      "Bash(npm ci *)",
      "Bash(git checkout . *)",
      "Bash(git stash drop *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(uv pip install *)",
      "Bash(npm ci *)",
      "Bash(npm add *)",
      "Bash(pnpm i *)",
      "Bash(yarn *)",
      "Bash(bun add *)",
      "Bash(bun install *)",
      "Bash(bun i *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(rm *)",
      "Bash(docker *)",
      "Bash(terraform *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["git fetch", "git pull"],
    "network": {
      "allowedDomains": ["api.github.com", "registry.npmjs.org", "pypi.org"]
    },
    "filesystem": {
      "denyWrite": ["./.git/config", "./.git/config.worktree", "./.git/hooks"]
    }
  }
}
