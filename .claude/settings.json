{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "UV_CACHE_DIR": ".cache/uv",
    "UV_TOOL_DIR": ".cache/uv-tools",
    "PRE_COMMIT_HOME": ".cache/pre-commit"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "blockWritesOutsideWorkingDirectories": true,
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm validate)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm format:check)"
    ],
    "deny": [
      "Read(~/.codex/auth.json)",
      "Read(~/.git-credentials)",
      "Bash(security *)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Bash(sudo *)",
      "Bash(git push *)",
      "Bash(git filter-branch *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform state *)",
      "Bash(tofu apply *)",
      "Bash(tofu destroy *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl apply *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(az *)",
      "Bash(gsutil *)",
      "Bash(bq *)",
      "Bash(vercel *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(uv publish *)",
      "Bash(twine upload *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(printenv *)",
      "Bash(env)",
      "Edit(/.claude)",
      "Edit(/.claude/**)",
      "Edit(/.codex)",
      "Edit(/.codex/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.codex/config.toml)",
      "Edit(~/.codex/rules)",
      "Edit(~/.codex/hooks.json)",
      "Edit(~/.codex/requirements.toml)",
      "Edit(~/.codex/managed_config.toml)",
      "Edit(~/.codex/*.config.toml)",
      "Edit(~/.codex/rules/**)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm add *)",
      "Bash(npm update *)",
      "Bash(npx *)",
      "Bash(pnpm install *)",
      "Bash(pnpm i *)",
      "Bash(pnpm add *)",
      "Bash(pnpm update *)",
      "Bash(pnpm dlx *)",
      "Bash(uv add *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv pip *)",
      "Bash(uvx *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip *)",
      "Bash(python3 -m pip *)",
      "Bash(yarn *)",
      "Bash(bun add *)",
      "Bash(bun install *)",
      "Bash(bun i *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout . *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop *)",
      "Bash(rm -*r*)",
      "Bash(rm -*R*)",
      "Bash(rm * -*r*)",
      "Bash(rm * -*R*)",
      "Bash(rm *--recursive*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm *)",
      "Bash(find * -execdir rm *)",
      "Bash(rsync *--delete*)",
      "Bash(rimraf *)",
      "Bash(pnpm exec rimraf *)",
      "Bash(git rm -r*)",
      "Bash(docker *)",
      "Bash(terraform *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git fetch",
      "git pull"
    ],
    "network": {
      "allowedDomains": [
        "api.github.com",
        "registry.npmjs.org",
        "pypi.org"
      ]
    },
    "filesystem": {
      "denyRead": ["~/.codex/auth.json", "~/.git-credentials"],
      "denyWrite": [
        "./.git/config",
        "./.git/config.worktree",
        "./.git/hooks",
        "./.claude",
        "./.codex"
      ]
    }
  }
}
